root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# YAML and TOML conventionally use 2-space indentation.
[*.{yml,yaml,toml}]
indent_size = 2

# Makefiles require literal tabs for recipe lines.
[Makefile]
indent_style = tab

# Markdown uses two trailing spaces for hard line breaks; don't strip them.
[*.md]
trim_trailing_whitespace = false
